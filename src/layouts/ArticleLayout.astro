---
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import ArticleImage from '../components/ArticleImage.astro';
import { IMAGE_WIDTHS, UI } from '../consts';
import { formatDate } from '../utils/articles';
import type { Crumb } from '../utils/url';

interface Props {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  image?: ImageMetadata;
  imageAlt: string;
  breadcrumbs: Crumb[];
}

const { title, description, date, updated, image, imageAlt, breadcrumbs } = Astro.props;
---

<BaseLayout title={title} description={description} breadcrumbs={breadcrumbs}>
  <article class="article">
    <header>
      <h1>{title}</h1>
      <p class="meta">
        {UI.publishedOn} <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {
          updated && (
            <>
              {' – '}{UI.updatedOn} <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
            </>
          )
        }
      </p>
      <ArticleImage
        class="hero"
        image={image}
        alt={imageAlt}
        widths={IMAGE_WIDTHS.article}
        sizes="(max-width: 44rem) 100vw, 44rem"
        loading="eager"
      />
    </header>
    <div class="prose">
      <slot />
    </div>
    <slot name="after-article" />
  </article>
</BaseLayout>

<style>
  .article {
    max-width: var(--article-width);
    margin: 0 auto;
  }

  h1 {
    margin: 0 0 0.5rem;
    font-size: clamp(1.875rem, 5vw, 2.75rem);
  }

  .meta {
    margin: 0 0 1.5rem;
    color: var(--color-muted);
    font-size: 0.9375rem;
  }

  .article :global(.hero) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
    margin-bottom: 2rem;
  }

  .prose :global(h2) {
    margin-top: 2.5rem;
  }

  .prose :global(a) {
    color: var(--color-primary);
  }

  .prose :global(blockquote) {
    margin: 1.5rem 0;
    padding: 0.5rem 1.25rem;
    border-left: 4px solid var(--color-primary);
    background: var(--color-container);
    border-radius: 0 0.5rem 0.5rem 0;
  }

  .prose :global(img) {
    border-radius: var(--radius);
  }

  .prose :global(figure) {
    margin: 2rem 0;
  }

  .prose :global(figcaption) {
    margin-top: 0.625rem;
    font-size: 0.9375rem;
    font-style: italic;
    text-align: center;
    color: var(--color-muted);
  }
</style>
