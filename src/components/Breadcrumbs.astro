---
import { UI } from '../consts';
import { withBase } from '../utils/url';
import type { Crumb } from '../utils/url';

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label={UI.breadcrumbLabel}>
  <ol>
    {
      items.map((item, i) => (
        <li>
          <a href={withBase(item.href)} aria-current={i === items.length - 1 ? 'page' : undefined}>
            {item.title}
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumbs {
    margin-bottom: 1.5rem;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  ol {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li:not(:last-child)::after {
    content: '>';
    margin: 0 0.5rem;
  }

  a {
    color: var(--color-muted);
    text-decoration: none;
  }

  a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  a[aria-current='page'] {
    color: var(--color-text);
    font-weight: 500;
  }
</style>
