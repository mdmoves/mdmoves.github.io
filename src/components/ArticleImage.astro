---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { PLACEHOLDER_IMAGE } from '../consts';
import { withBase } from '../utils/url';

interface Props {
  image?: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  class?: string;
  loading?: 'lazy' | 'eager';
}

const { image, alt, widths, sizes, class: className, loading = 'lazy' } = Astro.props;
// Fallback `src` uses the largest requested width instead of the full-size original.
const width = image ? Math.min(image.width, Math.max(...widths)) : undefined;
---

{
  image ? (
    <Image
      src={image}
      alt={alt}
      width={width}
      widths={widths}
      sizes={sizes}
      class={className}
      loading={loading}
    />
  ) : (
    <img
      src={withBase(PLACEHOLDER_IMAGE)}
      alt={alt}
      class={className}
      loading={loading}
      width="1280"
      height="800"
    />
  )
}
